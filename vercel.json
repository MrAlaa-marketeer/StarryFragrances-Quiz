    {
      "source": "/return-exchange-policy",
      "destination": "/"
    },
    {
      "source": "/shop",
      "destination": "/"
    },
    {
      "source": "/quiz",
      "destination": "/"
    },
    {
      "source": "/result",
      "destination": "/"
    },
    {
      "source": "/fragrance/:slug",
